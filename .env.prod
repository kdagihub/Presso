# =================================================================
# PRESSO - VARIABLES D'ENVIRONNEMENT
# =================================================================
# Ne JAMAIS commit ce fichier (contient des secrets)
# =================================================================

# -----------------------------------------------------------------
# DJANGO CORE
# -----------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-r1#kt$(y_kd8xqgh@^gdvd77+kel2w5r@d1e066b)^5!y6i-v$
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.presso.pro
DJANGO_CSRF_TRUSTED_ORIGINS=https://presso.pro,https://api.presso.pro

# -----------------------------------------------------------------
# DATABASE (PostgreSQL + PostGIS)
# -----------------------------------------------------------------
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=presso_db
DB_USER=presso_user
DB_PASSWORD=presso_password_change_me
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------------------------
# REDIS (Cache + Celery + JWT Blacklist)
# -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------
JWT_SECRET_KEY=votre-jwt-secret-key-differente-de-django-changez-moi
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_DOMAIN=.presso.pro
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=None

# -----------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://presso.pro,https://www.presso.pro
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------------------------------
# ORANGE SMS API (Côte d'Ivoire)
# -----------------------------------------------------------------
ORANGE_SMS_CLIENT_ID=votre_client_id_orange_developer
ORANGE_SMS_CLIENT_SECRET=votre_client_secret_orange_developer
ORANGE_SMS_SENDER_ADDRESS=tel:+225XXXXXXXXXX
ORANGE_SMS_SENDER_NAME=Presso
ORANGE_SMS_BASE_URL=https://api.orange.com
ORANGE_SMS_TOKEN_URL=https://api.orange.com/oauth/v3/token
ORANGE_SMS_DR_NOTIFY_URL=https://api.presso.pro/webhooks/orange/dr

# -----------------------------------------------------------------
# OTP (One-Time Password)
# -----------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------
# EMAIL (Optionnel - pour notifications admin)
# -----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
DEFAULT_FROM_EMAIL=noreply@presso.pro

# -----------------------------------------------------------------
# MEDIA & STATIC FILES
# -----------------------------------------------------------------
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# -----------------------------------------------------------------
# ADMIN CUSTOMIZATION
# -----------------------------------------------------------------
ADMIN_SITE_HEADER=PRESSO Administration
ADMIN_SITE_TITLE=PRESSO Admin
ADMIN_INDEX_TITLE=Tableau de bord PRESSO

# -----------------------------------------------------------------
# RATE LIMITING (DRF Throttling)
# -----------------------------------------------------------------
THROTTLE_ANON_RATE=20/minute
THROTTLE_USER_RATE=120/minute
THROTTLE_AUTH_RATE=5/minute

# -----------------------------------------------------------------
# CELERY
# -----------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# -----------------------------------------------------------------
# SECURITY (Production)
# -----------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
